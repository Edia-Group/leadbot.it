# Production image for apps/landing-page (TanStack Start + Nitro node-server).
# Build: START_TARGET=node-server selects Nitro preset (see @tanstack/start-plugin-core).
ARG BUN_VERSION=1.3.6
FROM debian:bullseye-slim AS build-bun
ARG BUN_VERSION
RUN apt-get update -qq \
    && apt-get install -qq --no-install-recommends \
    ca-certificates curl dirmngr gpg gpg-agent unzip \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && arch="$(dpkg --print-architecture)" \
    && case "${arch##*-}" in \
    amd64) build="x64-baseline";; \
    arm64) build="aarch64";; \
    *) echo "error: unsupported architecture: $arch"; exit 1 ;; \
    esac \
    && version="$BUN_VERSION" \
    && case "$version" in \
    latest | canary | bun-v*) tag="$version";; \
    v*) tag="bun-$version";; \
    *) tag="bun-v$version";; \
    esac \
    && case "$tag" in \
    latest) release="latest/download";; \
    *) release="download/$tag";; \
    esac \
    && curl "https://github.com/oven-sh/bun/releases/$release/bun-linux-$build.zip" -fsSLO --compressed --retry 5 \
    && unzip -q "bun-linux-$build.zip" \
    && mv "bun-linux-$build/bun" /usr/local/bin/bun \
    && chmod +x /usr/local/bin/bun \
    && rm -rf "bun-linux-$build.zip" "bun-linux-$build"

FROM node:22-bullseye-slim AS base
COPY --from=build-bun /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx \
    && apt-get -qy update \
    && apt-get -qy --no-install-recommends install openssl ca-certificates git python3 g++ build-essential \
    && update-ca-certificates \
    && groupadd bun --gid 2000 \
    && useradd bun --uid 2000 --gid bun --shell /bin/sh --create-home
WORKDIR /app

FROM base AS pruned
ARG SCOPE=landing-page
COPY . .
RUN bunx turbo prune "${SCOPE}" --docker

FROM base AS builder
ARG DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# Build-resource caps to avoid OOM-ing a shared host (Dokploy). Tune via buildArgs:
#   MAKE_JOBS         parallel native (g++) compile jobs
#   BUILD_CONCURRENCY turbo tasks built in parallel (workspace packages)
#   NODE_HEAP_MB      max old-space per Node process during the build
ARG MAKE_JOBS=2
ARG BUILD_CONCURRENCY=1
ARG NODE_HEAP_MB=4096
ENV START_TARGET=node-server
ENV SKIP_ENV_CHECK=true
ARG NEXT_PUBLIC_VIEWER_URL=https://viewer.nucleoai.it
ENV NEXT_PUBLIC_VIEWER_URL=${NEXT_PUBLIC_VIEWER_URL}
COPY --from=pruned /app/out/full/ .
COPY bun.lock .
COPY bunfig.toml .
RUN SENTRYCLI_SKIP_DOWNLOAD=1 MAKEFLAGS="-j${MAKE_JOBS}" bun install
RUN DATABASE_URL=$DATABASE_URL bunx tsx packages/prisma/scripts/db-generate.ts
RUN DATABASE_URL=$DATABASE_URL START_TARGET=node-server SKIP_ENV_CHECK=true \
    NODE_OPTIONS="--max-old-space-size=${NODE_HEAP_MB}" \
    bunx turbo run build:docker --filter=landing-page --concurrency=${BUILD_CONCURRENCY}

FROM node:22-bullseye-slim AS release
WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
COPY --from=builder /app/apps/landing-page/.output ./.output
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
