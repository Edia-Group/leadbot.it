# --- Core (required) ---
# 32 characters exactly — used for encryption and NextAuth
ENCRYPTION_SECRET=do+UspMmB/rewbX2K/rskFmtgGSSZ8Ta

DATABASE_URL=postgresql://postgres:leadbot@localhost:5432/leadbot

NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_VIEWER_URL=http://localhost:3001

NODE_OPTIONS=--no-node-snapshot

# First admin / bootstrap (comma-separated emails allowed)
ADMIN_EMAIL=admin@example.com

# --- File uploads (MinIO — match docker-compose.dev.yml) ---
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=leadbot
S3_PORT=9000
S3_ENDPOINT=localhost
S3_SSL=false

# --- Email sign-in (Render SMTP or any SMTP provider) ---
# Create an SMTP credential in the Render dashboard and map:
NEXT_PUBLIC_SMTP_FROM="LeadBot <onboarding@yourdomain.com>"
SMTP_HOST=smtp.render.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# Optional: disable SMTP auth if your relay does not use it (uncommon)
# SMTP_AUTH_DISABLED=true

# More options: https://docs.leadbot.it/self-hosting/configuration
