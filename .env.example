# --- Core (required) ---
# 32 characters exactly — used for encryption and NextAuth
ENCRYPTION_SECRET=do+UspMmB/rewbX2K/rskFmtgGSSZ8Ta

DATABASE_URL=postgresql://postgres:leadbot@localhost:5433/leadbot

NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_VIEWER_URL=http://localhost:3001

NODE_OPTIONS=--no-node-snapshot

# First admin / bootstrap (comma-separated emails allowed)
ADMIN_EMAIL=admin@example.com

# --- File uploads (MinIO — match docker-compose.dev.yml) ---
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=leadbot
S3_PORT=9000
S3_ENDPOINT=localhost
S3_SSL=false

# --- Email sign-in ---
# Local dev: start docker-compose.dev.yml (includes Mailpit) then open http://localhost:8025 for messages
NEXT_PUBLIC_SMTP_FROM="NUCLEO <dev@localhost>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Production: use your provider (e.g. Resend, SendGrid, SES) instead of Mailpit
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Optional: disable SMTP auth if your relay does not use it (uncommon)
# SMTP_AUTH_DISABLED=true

# More options: https://docs.nucleoai.it/self-hosting/configuration
